---
// La base (punto de encuentro): mitad texto y mitad foto a sangre (derecha). Cabeza con barra, la dirección de
// site.yaml → contacto en letra condensada grande con «Cómo llegar» (mapa), los servicios (`items: [{titulo}]`:
// vestuarios, duchas, aparcamiento…) en dos columnas con filete y el horario por temporadas (`horario: [{dia, horas}]`)
// en tabla con las horas en JetBrains Mono. Sin `imagen`, solo el texto.
import { seccion, site, mapa } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const servicios = (s?.items ?? []).filter((it) => it?.titulo);
const horario = (s?.horario ?? []).filter((h) => h?.dia || h?.horas);
---

{
  s && (s.titulo || s.texto || s.antetitulo || s.imagen || c.direccion || servicios.length > 0 || horario.length > 0) && (
    <section id={id} class:list={['mitades', { 'mitades--sin-foto': !s.imagen }]}>
      <div class="mitad-texto">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {c.direccion && <p class="direccion-grande">{c.direccion}</p>}
        {c.direccion && (
          <p class="botones">
            <a class="btn-borde" href={mapa(c.direccion)} rel="noopener" target="_blank"><Icono nombre="mapa" tam={18} /> Cómo llegar</a>
          </p>
        )}
        {servicios.length > 0 && (
          <ul class="servicios">
            {servicios.map((it) => (
              <li><Icono nombre={it.icono || 'check'} tam={20} />{it.titulo}</li>
            ))}
          </ul>
        )}
        {horario.length > 0 && (
          <table class="horario">
            <caption>Horario</caption>
            <tbody>
              {horario.map((h) => (
                <tr>
                  <th scope="row">{h.dia}</th>
                  <td>{h.horas}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
      {s.imagen && (
        <div class="mitad-foto foto foto--sangre">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
        </div>
      )}
    </section>
  )
}
