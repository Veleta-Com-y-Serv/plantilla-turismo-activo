---
// Titular de sección: etiqueta (antetítulo, en la cara de texto y caja normal) + título en Saira Condensed en
// mayúsculas + entrada. Sin campos, no pinta nada. `cabeza`: barra de 2 px arriba, título a la izquierda y entrada a la
// derecha en escritorio. El título se mide por su columna (`.cq`), así una palabra de 20 letras siempre cabe.
import { anchoTitular } from '../../data/site';
interface Props { titulo?: string; antetitulo?: string; texto?: string; class?: string; nivel?: 1 | 2; cabeza?: boolean }
const { titulo, antetitulo, texto, class: clase = '', nivel = 2, cabeza = false } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
const k = anchoTitular(titulo);
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={[cabeza ? 'cabeza' : 'titular', clase]}>
      {(antetitulo || titulo) && (
        <div class="cq">
          {antetitulo && <p class="antetitulo">{antetitulo}</p>}
          {titulo && <H class="titulo-seccion" style={`--k:${k}`}>{titulo}</H>}
        </div>
      )}
      {texto && <p class="entrada">{texto}</p>}
    </div>
  )
}
