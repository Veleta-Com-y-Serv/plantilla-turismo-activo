---
// Banda a todo el ancho de la ventana (fondo pleno de borde a borde) con el contenido en el contenedor
// (90 rem, 16 px de margen en móvil). `color`: papel | clara | tinta (como mucho dos bandas oscuras por página, contando el pie).
interface Props { id?: string; color?: string; class?: string; etiqueta?: string; contenedor?: boolean }
const { id, color = 'papel', class: clase = '', etiqueta, contenedor = true } = Astro.props;
---

<section id={id} class:list={['banda', `banda--${color}`, clase]} aria-label={etiqueta}>
  {contenedor ? <div class="contenedor"><slot /></div> : <slot />}
</section>
