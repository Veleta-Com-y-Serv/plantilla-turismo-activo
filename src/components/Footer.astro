---
// Pie «salida»: banda oscura (color primario) a todo el ancho con el nombre muy grande en Saira Condensed (mástil) y
// cuatro columnas: contacto, la base (dirección y horario), el menú y las redes. Todo de site.yaml → contacto, redes y menu.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false (plan gratis).
// En móvil, barra fija abajo con «Llamar», «WhatsApp» y «Reservar» (boton_cabecera o, sin él, el contacto).
import { site, tel, mapa, whatsapp, seccion, anchoTitular } from '../data/site';
import { enlace } from '../lib/multipagina';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'salida' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const wa = whatsapp(c.whatsapp, `Hola, quiero reservar una actividad en ${site.nombre}`);
const reservar = site.boton_cabecera?.url
  ? { texto: 'Reservar', url: site.boton_cabecera.url }
  : seccion('contacto')
    ? { texto: 'Reservar', url: enlace('/#contacto') }
    : null;
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor cq">
    <p class="pie-mastil" style={`--k:${anchoTitular(site.nombre, 4)}`}>{site.nombre}</p>
    {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
    <div class="pie-columnas">
      {
        (c.telefono || c.email || c.whatsapp) && (
          <div>
            <p class="pie-titulo">Reservas</p>
            <ul class="pie-lista pie-dato">
              {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp</a></li>}
              {c.email && <li class="break-words"><a href={`mailto:${c.email}`}>{c.email}</a></li>}
            </ul>
          </div>
        )
      }
      {
        (c.direccion || c.horario) && (
          <div>
            <p class="pie-titulo">La base</p>
            {c.direccion && (
              <p class="pie-dato"><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></p>
            )}
            {c.horario && <p class="pie-dato mt-3">{c.horario}</p>}
          </div>
        )
      }
      {
        site.menu.length > 0 && (
          <div>
            <p class="pie-titulo">En esta web</p>
            <ul class="pie-lista">
              {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
            </ul>
          </div>
        )
      }
      {
        redes.length > 0 && (
          <div>
            <p class="pie-titulo">Síguenos</p>
            <ul class="pie-redes">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={20} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  {
    (c.telefono || wa || reservar) && (
      <nav class="barra-movil" aria-label="Llamar o reservar">
        {c.telefono && (
          <a class="btn-borde" href={tel(c.telefono)}>
            <Icono nombre="telefono" tam={18} /> Llamar
          </a>
        )}
        {wa && (
          <a class="btn-borde" href={wa} rel="noopener" target="_blank">
            <Icono nombre="whatsapp" tam={18} /> WhatsApp
          </a>
        )}
        {reservar && <a class="btn" href={reservar.url}>{reservar.texto}</a>}
      </nav>
    )
  }
</footer>
